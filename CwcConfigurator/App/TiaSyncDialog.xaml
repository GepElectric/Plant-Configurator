<Window x:Class="CwcConfigurator.App.TiaSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Sync"
        Width="980"
        Height="820"
        MinWidth="860"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save mapping" Width="110" Click="SaveMapping_Click"/>
            <Button Content="Close" Width="82" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="TIA Sync" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Foreground="#57606A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="RefreshProcessesButton" Content="Refresh processes" Width="132" Click="RefreshProcesses_Click"/>
                        <Button x:Name="AttachButton" Content="Attach" Width="86" Click="Attach_Click"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Width="96" Click="Disconnect_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="1 · TIA process"
                           ToolTip="Step 1: pick the running TIA Portal instance and attach. Discovered PLCs are then matched to your databases automatically."/>
                <ComboBox x:Name="ProcessCombo" Grid.Column="1" Height="28"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" MinHeight="150"/>
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="2 · PLC database mapping — review, then Save">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="AutoMapButton" Content="Auto-map by name" Width="140" Click="AutoMap_Click"
                                    ToolTip="Match every unmapped PLC database to a discovered TIA PLC by name. Databases that already point at an existing TIA PLC are left untouched."/>
                            <Button x:Name="ValidateMappingButton" Content="Validate mapping" Width="130" Click="ValidateMapping_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="MappingGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PLC database" Binding="{Binding PlcName}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Header="TIA device" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeviceName}" VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DeviceNames, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TIA software" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SoftwareName}" VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      Text="{Binding SoftwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding SoftwareNames, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="Sequence in global pull/push"
                                                        Binding="{Binding IncludeSequenceInGlobalSync, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="160"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" IsReadOnly="True" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="Foreground" Value="#CF222E"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="OK">
                                                    <Setter Property="Foreground" Value="#1A7F37"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Not attached">
                                                    <Setter Property="Foreground" Value="#57606A"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="3 · SCADA database → WinCC Unified device" Margin="0,8,0,0"
                              ToolTip="Map each SCADA database to one WinCC Unified device. To pull from another device, add a new SCADA database and map it.">
                        <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="Create SCADA databases from TIA" Padding="10,3" Margin="0,0,6,0" Click="CreateScadaDatabases_Click"
                                    ToolTip="For every WinCC Unified device of the TIA project without a SCADA database: create one, map it and pull it."/>
                            <Button Content="Auto-map SCADA" Padding="10,3" Margin="0,0,6,0" Click="AutoMapScada_Click"
                                    ToolTip="Map SCADA databases without a device to the Unified device with the same name (or the only one)."/>
                            <Button Content="Pull SCADA from TIA" Padding="10,3" Margin="0,0,6,0" Click="PullScada_Click"
                                    ToolTip="For every mapped SCADA database: read AUX_FUNCTIONS._SET_INTERNAL_TAG into the database and read the device's screens."/>
                            <Button Content="Push SCADA to TIA" Padding="10,3" Click="PushScada_Click"
                                    ToolTip="For every mapped SCADA database: write the database back into AUX_FUNCTIONS._SET_INTERNAL_TAG of its device (the rest of the module stays; the TIA project is not saved)."/>
                        </WrapPanel>
                        <DataGrid x:Name="ScadaMappingGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SCADA database" Binding="{Binding ScadaName}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Header="Unified device" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeviceName}" VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding UnifiedDeviceNames, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" IsReadOnly="True" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="Foreground" Value="#CF222E"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="OK">
                                                    <Setter Property="Foreground" Value="#1A7F37"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Not attached">
                                                    <Setter Property="Foreground" Value="#57606A"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>

                <GroupBox Grid.Column="2" Header="Discovered PLCs in TIA project">
                    <DockPanel>
                        <TextBlock x:Name="ObjectsSummaryText"
                                   DockPanel.Dock="Bottom"
                                   Margin="0,8,0,0"
                                   Foreground="#57606A"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="CreateDatabaseFromPlcButton"
                                DockPanel.Dock="Bottom"
                                Content="Create database from selected PLC"
                                Margin="0,8,0,0"
                                Click="CreateDatabaseFromPlc_Click"
                                ToolTip="Adds a new PLC database mapped to the selected TIA PLC and pulls its full content immediately."/>
                        <ListBox x:Name="DiscoveredPlcList" SelectionChanged="DiscoveredPlcList_SelectionChanged"/>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Row="3" Header="Output" Margin="0,12,0,0">
                <TextBox x:Name="OutputText"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
