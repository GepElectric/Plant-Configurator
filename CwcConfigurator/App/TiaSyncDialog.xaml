<Window x:Class="CwcConfigurator.App.TiaSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Sync"
        Width="980"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save mapping" Width="110" Click="SaveMapping_Click"/>
            <Button Content="Close" Width="82" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="TIA Sync" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Foreground="#57606A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="RefreshProcessesButton" Content="Refresh processes" Width="132" Click="RefreshProcesses_Click"/>
                        <Button x:Name="AttachButton" Content="Attach" Width="86" Click="Attach_Click"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Width="96" Click="Disconnect_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TIA process" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="ProcessCombo" Grid.Column="1" Height="28"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="PLC database mapping">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="ValidateMappingButton" Content="Validate mapping" Width="130" Click="ValidateMapping_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="MappingGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PLC database" Binding="{Binding PlcName}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="TIA device" Binding="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridComboBoxColumn x:Name="TiaSoftwareColumn"
                                                        Header="TIA software"
                                                        SelectedItemBinding="{Binding SoftwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*"/>
                                <DataGridCheckBoxColumn Header="Sequence in global pull/push"
                                                        Binding="{Binding IncludeSequenceInGlobalSync, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="160"/>
                                <DataGridTextColumn Header="State" Binding="{Binding SyncState}" IsReadOnly="True" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Discovered PLC software">
                    <DockPanel>
                        <TextBlock x:Name="ObjectsSummaryText"
                                   DockPanel.Dock="Bottom"
                                   Margin="0,8,0,0"
                                   Foreground="#57606A"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="CreateDatabaseFromPlcButton"
                                DockPanel.Dock="Bottom"
                                Content="Create PLC database"
                                Margin="0,8,0,0"
                                Click="CreateDatabaseFromPlc_Click"/>
                        <ListBox x:Name="DiscoveredPlcList" SelectionChanged="DiscoveredPlcList_SelectionChanged"/>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Row="3" Header="Output" Margin="0,12,0,0">
                <TextBox x:Name="OutputText"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
