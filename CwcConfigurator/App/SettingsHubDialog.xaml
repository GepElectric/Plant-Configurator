<Window x:Class="CwcConfigurator.App.SettingsHubDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Settings"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0"
                Background="#FAFBFC"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#57606A"
                           FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ApplyButton"
                            Content="Apply"
                            Width="100"
                            Click="Apply_Click"
                            IsEnabled="False"/>
                    <Button x:Name="RevertButton"
                            Content="Revert"
                            Width="100"
                            Click="Revert_Click"
                            IsEnabled="False"
                            ToolTip="Discard local edits and reload from project."/>
                    <Button Content="Close"
                            Width="100"
                            IsCancel="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F6F8FA"
                    BorderBrush="#D0D7DE"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Settings"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="14,14,14,8"/>
                    <TreeView x:Name="SettingsTree"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="SettingsTree_SelectedItemChanged"/>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top"
                        BorderBrush="#D0D7DE"
                        BorderThickness="0,0,0,1"
                        Padding="28,18,28,14"
                        Background="#FFFFFF">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="Select a setting on the left"/>
                        <TextBlock x:Name="DetailSubtitle"
                                   Foreground="#57606A"
                                   FontSize="12"
                                   Margin="0,2,0,6"
                                   Text=""/>
                        <TextBlock x:Name="DetailDescription"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#444"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" Padding="24,16,24,16">
                    <ContentControl x:Name="EditorHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <StackPanel x:Name="EditorPlaceholder">
                            <CheckBox x:Name="BilingualCheckBox"
                                      Content="Multilingual project (validate *Other text fields)"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Click="BilingualCheckBox_Click"/>
                            <TextBlock x:Name="EmptyHint"
                                       Foreground="#57606A"
                                       FontStyle="Italic"
                                       Text="Pick a leaf on the left to start editing."/>
                        </StackPanel>
                    </ContentControl>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
