<Window x:Class="CwcConfigurator.App.AlarmTesterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm Tester"
        Width="1420"
        Height="820"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ToolbarTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,12,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,5,0"/>
            <Setter Property="Fill" Value="#C9CED6"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F6F8FA">
        <Border DockPanel.Dock="Top" Background="#0F2547" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Alarm Tester" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="SummaryText" Foreground="#9FB3D1" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Close" IsCancel="True" Padding="14,5" MinWidth="90"
                        Background="#33FFFFFF" Foreground="#FFFFFF" BorderThickness="0"/>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PLC" Foreground="#9FB3D1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PlcSelector" Width="140" Margin="6,0,14,0" Padding="6,4"
                              VerticalContentAlignment="Center" SelectionChanged="PlcSelector_SelectionChanged"/>

                    <Ellipse x:Name="S7Dot" Style="{StaticResource StatusDot}"/>
                    <TextBlock Text="IP" Foreground="#9FB3D1" VerticalAlignment="Center"/>
                    <TextBox x:Name="IpAddressText" Width="116" Text="10.248.34.217" Style="{StaticResource ToolbarTextBox}"/>
                    <TextBlock Text="Rack" Foreground="#9FB3D1" VerticalAlignment="Center"/>
                    <TextBox x:Name="RackText" Width="42" Text="0" Style="{StaticResource ToolbarTextBox}"/>
                    <TextBlock Text="Slot" Foreground="#9FB3D1" VerticalAlignment="Center"/>
                    <TextBox x:Name="SlotText" Width="42" Text="1" Style="{StaticResource ToolbarTextBox}"/>
                    <Button x:Name="ConnectS7Button" Content="Connect S7" Style="{StaticResource PrimaryButton}" Click="ConnectS7_Click"/>
                    <Button Content="Disconnect" Style="{StaticResource PrimaryButton}" Background="#475569" Click="Disconnect_Click"/>
                    <Button Content="Refresh States" Style="{StaticResource PrimaryButton}" Background="#475569" Click="RefreshStates_Click"/>
                    <TextBlock x:Name="S7ConnectionText" Text="S7 not connected" Foreground="#9FB3D1" VerticalAlignment="Center" Margin="6,0,18,0"/>

                    <Ellipse x:Name="PipeDot" Style="{StaticResource StatusDot}"/>
                    <TextBlock Text="RT system" Foreground="#9FB3D1" VerticalAlignment="Center"/>
                    <TextBox x:Name="RtSystemText" Width="104" Text="RUNTIME_1" Style="{StaticResource ToolbarTextBox}"/>
                    <Button x:Name="ConnectPipeButton" Content="Connect OpenPipe" Style="{StaticResource PrimaryButton}" Background="#0E9F6E" MinWidth="120" Click="ConnectPipe_Click"/>
                    <TextBlock x:Name="PipeConnectionText" Text="OpenPipe not connected" Foreground="#9FB3D1" VerticalAlignment="Center" Margin="6,0,18,0"/>

                    <TextBlock Text="Reset tag" Foreground="#9FB3D1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ResetTagBox" Width="210" Margin="6,0,6,0" Padding="6,4" IsEditable="True"
                              VerticalContentAlignment="Center"/>
                    <Button x:Name="BrowseResetButton" Content="Find" Style="{StaticResource PrimaryButton}" Background="#475569" MinWidth="64" Click="BrowseResetTag_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="220"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="2*" MinHeight="160"/>
            </Grid.RowDefinitions>

            <Border Background="#FFFFFF" BorderBrush="#D0D7DE" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterBox" Padding="8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
                        <ComboBox x:Name="ModuleFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="ModuleFilter_SelectionChanged"/>
                    </Grid>

                    <ScrollViewer x:Name="SignalsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="SignalsScroll_PreviewMouseWheel">
                        <ItemsControl x:Name="ModulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=OneWay}" Margin="0,0,0,12"
                                              Expanded="Module_Expanded" Collapsed="Module_Collapsed">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock Text="{Binding Signals.Count, StringFormat={}{0} signal(s)}" Foreground="#57606A"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <DataGrid ItemsSource="{Binding Signals}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  HeadersVisibility="Column"
                                                  IsReadOnly="True"
                                                  RowHeight="36"
                                                  GridLinesVisibility="Horizontal"
                                                  SelectionMode="Single"
                                                  SelectionChanged="SignalsGrid_SelectionChanged">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLastTested}" Value="True">
                                                            <Setter Property="Background" Value="#FFF1B8"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Ch" Binding="{Binding PortLabel}" Width="48"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding CurrentStateLabel}" Width="76"/>
                                                <DataGridTemplateColumn Header="Action" Width="105">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding ToggleLabel}" Tag="{Binding}" Padding="8,3" Click="ToggleSignal_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Variable" Binding="{Binding VariableName}" Width="1.4*"/>
                                                <DataGridTextColumn Header="DI system" Binding="{Binding SystemName}" Width="1.4*"/>
                                                <DataGridTextColumn Header="DI signal" Binding="{Binding SignalName}" Width="2*"/>
                                                <DataGridTextColumn Header="DI ID" Binding="{Binding SignalId}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#D0D7DE" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D0D7DE" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#EAF1FB" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#1E3A6B"
                                   Text="Pick a PLC, connect S7 and OpenPipe, then toggle a signal."/>
                    </Border>

                    <DataGrid x:Name="EventsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              ColumnHeaderHeight="30"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeLabel}" Width="110"/>
                            <DataGridTextColumn Header="Alarm" Binding="{Binding AlarmNumber}" Width="70"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding AlarmClassName}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Alarm system" Binding="{Binding AlarmSystem}" Width="1.4*"/>
                            <DataGridTemplateColumn Header="Alarm text" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AlarmText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
