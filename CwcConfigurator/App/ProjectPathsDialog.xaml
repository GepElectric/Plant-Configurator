<Window x:Class="CwcConfigurator.App.ProjectPathsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Paths"
        Width="680"
        Height="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PLC-to-config source folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="PlcPathText" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="R source folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="RPathText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="2" Text="Generated files output folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="OutputPathText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Text="TIA Portal export folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="TiaExportPathText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Text="WinCC Unified JS connector folder" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="UnifiedJsConnectorFolderText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Text="WinCC Unified JS REST server" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="UnifiedJsConnectorServerPathText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Foreground="#57606A" TextWrapping="Wrap"
                       Text="Used paths: Generated files output folder is used by file generation, TIA sync and PDF export. TIA Portal export folder is used as the default folder for importing exported TIA files. WinCC Unified JS connector paths are used for Unified script module import/export support."/>
        </Grid>
    </DockPanel>
</Window>
