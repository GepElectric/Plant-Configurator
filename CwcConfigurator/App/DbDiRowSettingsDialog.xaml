<Window x:Class="CwcConfigurator.App.DbDiRowSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CwcConfigurator.App"
        Title="DB Row Settings"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="430"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ColorValueToBrushConverter x:Key="ColorValueToBrushConverter"/>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="ColorValueTemplate">
            <Grid MinHeight="24">
                <Rectangle Fill="{Binding Converter={StaticResource ColorValueToBrushConverter}}"/>
                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#000000"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="RowTitleText" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="RowSubtitleText" Foreground="#57606A" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="STATUS SYSTEM ENG" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="StatusSystemEngText" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,4"/>
            <CheckBox x:Name="ApplyStatusSystemEngToStructureCheck"
                      Grid.Row="1"
                      Grid.Column="1"
                      Content="Apply STATUS SYSTEM ENG to all 32 rows in this structure"
                      Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Text="STATUS NAME ENG" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="StatusNameEngText" Grid.Row="2" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="3" Text="STATUS SYSTEM OTHER" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox x:Name="StatusSystemOtherText" Grid.Row="3" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,4"/>
            <CheckBox x:Name="ApplyStatusSystemOtherToStructureCheck"
                      Grid.Row="4"
                      Grid.Column="1"
                      Content="Apply STATUS SYSTEM OTHER to all 32 rows in this structure"
                      Margin="0,0,0,10"/>

            <TextBlock Grid.Row="5" Text="STATUS NAME OTHER" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="StatusNameOtherText" Grid.Row="5" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,8"/>

            <TextBlock x:Name="ColorValue0Label" Grid.Row="6" Text="COLOR VAL 0" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                <ComboBox x:Name="ColorValue0Combo"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedValuePath="Value"
                          ItemTemplate="{StaticResource ColorValueTemplate}"
                          Background="{Binding SelectedValue, ElementName=ColorValue0Combo, Converter={StaticResource ColorValueToBrushConverter}}"
                          Foreground="#000000"
                          Opacity="0.01"/>
                <Rectangle Fill="{Binding SelectedValue, ElementName=ColorValue0Combo, Converter={StaticResource ColorValueToBrushConverter}}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding SelectedItem.Text, ElementName=ColorValue0Combo}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#000000"
                           IsHitTestVisible="False"/>
            </Grid>

            <TextBlock x:Name="ColorValue1Label" Grid.Row="7" Text="COLOR VAL 1" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Grid Grid.Row="7" Grid.Column="1">
                <ComboBox x:Name="ColorValue1Combo"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          SelectedValuePath="Value"
                          ItemTemplate="{StaticResource ColorValueTemplate}"
                          Background="{Binding SelectedValue, ElementName=ColorValue1Combo, Converter={StaticResource ColorValueToBrushConverter}}"
                          Foreground="#000000"
                          Opacity="0.01"/>
                <Rectangle Fill="{Binding SelectedValue, ElementName=ColorValue1Combo, Converter={StaticResource ColorValueToBrushConverter}}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="{Binding SelectedItem.Text, ElementName=ColorValue1Combo}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#000000"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
