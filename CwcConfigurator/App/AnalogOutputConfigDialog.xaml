<Window x:Class="CwcConfigurator.App.AnalogOutputConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AO Configuration"
        Width="1040"
        Height="640"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RowTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RowSubtitleText" Foreground="#57606A" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Config" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ConfigCombo" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="ID" Margin="0,0,0,4"/>
                    <TextBox x:Name="SelectedIdText" Style="{StaticResource CenteredEditText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="0,10,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="DB AO slicer" VerticalAlignment="Center"/>
                <TextBox x:Name="DbAoSlicerText" Grid.Column="1" TextChanged="DbAoSlicerText_TextChanged" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Reset filter" Margin="8,0,0,0" Click="ResetFilters_Click"/>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <DataGrid x:Name="DbAoGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="False"
                  SelectionChanged="DbAoGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="AO NUM" Binding="{Binding AoNumber}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="AO SYSTEM NAME" Binding="{Binding AoSystemName}" Width="190" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="NAME ENG" Binding="{Binding NameEnglish}" Width="220" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="NAME OTHER" Binding="{Binding NameOther}" Width="*" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="XREF ANA ID" Binding="{Binding CrossReferenceAnaCtrlIdCount}" Width="105" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="XREF VAL" Binding="{Binding CrossReferenceValCount}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
