<Window x:Class="CwcConfigurator.App.ValidateOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validate"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Width="460">
        <TextBlock Text="Validate project" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#57606A">
            Runs all per-row rules (DI / DO / MEAS / AO / ALM / PAR).
            Results are shown in the Problems pane.
        </TextBlock>

        <Border BorderBrush="#D0D7DE" BorderThickness="1" Padding="12" Background="#F6F8FA" CornerRadius="3">
            <StackPanel>
                <CheckBox x:Name="IncludeCrossReferenceCheckBox" Content="Include cross-reference checks (TIA xref scan)"/>
                <TextBlock TextWrapping="Wrap" Margin="22,6,0,0" Foreground="#8B6914" FontSize="12">
                    Enables VAL &gt; 1 (DO, AO) and TEMP &gt; 1 (ALM) error rules.
                    Requires up-to-date cross-reference data; if it isn't already
                    populated, the scan can take several minutes for large projects.
                    Use this only at the end of programming.
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Click="Cancel_Click"/>
            <Button Content="Validate" Width="110" Margin="8,0,0,0" IsDefault="True" Click="Validate_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
