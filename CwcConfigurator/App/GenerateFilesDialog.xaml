<Window x:Class="CwcConfigurator.App.GenerateFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Files"
        Width="560"
        Height="820"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="92" IsCancel="True"/>
            <Button Content="Generate" Width="92" IsDefault="True" Click="Generate_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Export folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderText" Height="26" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Browse..." Width="86" Margin="8,0,0,0" Click="BrowseOutputFolder_Click"/>
                </Grid>

                <CheckBox x:Name="SelectAllCheck" Content="Select all" Margin="0,0,0,12" Click="SelectAll_Click"/>

                <GroupBox Header="Configuration data files" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="ConfigurationGroupCheck" Content="Select all in group" Margin="0,0,0,8" Click="ConfigurationGroup_Click"/>
                        <CheckBox x:Name="DiCheck" Content="DI configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DoCheck" Content="DO configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="AiCheck" Content="AI configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="RtdCheck" Content="RTD configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="CounterCheck" Content="COUNTER configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="AoCheck" Content="AO configuration"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="DB configuration files" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="DbConfigurationGroupCheck" Content="Select all in group" Margin="0,0,0,8" Click="DbConfigurationGroup_Click"/>
                        <CheckBox x:Name="DbDiConfigurationCheck" Content="DB DI configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbDoConfigurationCheck" Content="DB DO configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbMeasConfigurationCheck" Content="DB MEAS configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbAoConfigurationCheck" Content="DB AO configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbAlmConfigurationCheck" Content="DB ALM configuration" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbParConfigurationCheck" Content="DB PAR configuration"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="DB name files" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="DbNameGroupCheck" Content="Select all in group" Margin="0,0,0,8" Click="DbNameGroup_Click"/>
                        <CheckBox x:Name="DbDiStringsCheck" Content="DB DI names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbDoStringsCheck" Content="DB DO names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbMeasStringsCheck" Content="DB MEAS names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbAlmStringsCheck" Content="DB ALM names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbParStringsCheck" Content="DB PAR names"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="DB group name files">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="DbGroupNameGroupCheck" Content="Select all in group" Margin="0,0,0,8" Click="DbGroupNameGroup_Click"/>
                        <CheckBox x:Name="DbDiGroupNamesCheck" Content="DB DI group names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbDoGroupNamesCheck" Content="DB DO group names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbMeasGroupNamesCheck" Content="DB MEAS group names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbAlmGroupNamesCheck" Content="DB ALM group names" Margin="0,0,0,6"/>
                        <CheckBox x:Name="DbParGroupNamesCheck" Content="DB PAR group names"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
