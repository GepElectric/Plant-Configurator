<Window x:Class="CwcConfigurator.App.DbDataBlockSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB Names and Numbers"
        Width="1120"
        Height="560"
        MinWidth="860"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add data block" Width="120" Click="AddRow_Click"/>
            <Button Content="Delete data block" Width="130" Margin="8,0,0,0" Click="DeleteRow_Click"/>
        </StackPanel>

        <DataGrid x:Name="DataBlockNamesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Width="70" Header="NUMBER" Binding="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="95" Header="DB" Binding="{Binding DbName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="115" Header="KIND" Binding="{Binding BlockKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="145" Header="FILE" Binding="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="220" Header="DATA BLOCK NAME" Binding="{Binding DataBlockName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="210" Header="DATA TYPE NAME" Binding="{Binding DataTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="170" Header="SOURCE COLUMN" Binding="{Binding SourceColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="80" Header="LAST ID" Binding="{Binding LastId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
