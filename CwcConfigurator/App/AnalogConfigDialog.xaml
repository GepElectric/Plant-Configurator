<Window x:Class="CwcConfigurator.App.AnalogConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analog Configuration"
        Width="1080"
        Height="700"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="RowTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RowSubtitleText" Foreground="#57606A" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Config" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ConfigCombo" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="ID" Margin="0,0,0,4"/>
                    <TextBox x:Name="SelectedIdText" Style="{StaticResource CenteredEditText}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                    <TextBlock Text="Filter Time" Margin="0,0,0,4"/>
                    <TextBox x:Name="FilterTimeText" Style="{StaticResource CenteredEditText}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="8,0,0,0">
                    <TextBlock Text="Custom Limits" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CustomLimitsCombo" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="8,0,0,0">
                    <TextBlock Text="Low Limit" Margin="0,0,0,4"/>
                    <TextBox x:Name="LowLimitText" Style="{StaticResource CenteredEditText}"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="8,0,0,0">
                    <TextBlock Text="High Limit" Margin="0,0,0,4"/>
                    <TextBox x:Name="HighLimitText" Style="{StaticResource CenteredEditText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="0,10,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DbSlicerLabel" Text="DB MEAS slicer" VerticalAlignment="Center"/>
                <TextBox x:Name="DbSlicerText" Grid.Column="1" TextChanged="DbSlicerText_TextChanged" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Reset filter" Margin="8,0,0,0" Click="ResetFilters_Click"/>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="IdFilter" SelectionChanged="ColumnFilter_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,3,0"/>
            <ComboBox x:Name="PlcStructureFilter" Grid.Column="1" SelectionChanged="ColumnFilter_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0"/>
            <ComboBox x:Name="PlcNameFilter" Grid.Column="2" SelectionChanged="ColumnFilter_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0"/>
            <ComboBox x:Name="SystemNameFilter" Grid.Column="3" SelectionChanged="ColumnFilter_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0"/>
            <ComboBox x:Name="NameFilter" Grid.Column="4" SelectionChanged="ColumnFilter_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0"/>
            <ComboBox x:Name="UnitFilter" Grid.Column="5" SelectionChanged="ColumnFilter_SelectionChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0,0,0"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <DataGrid x:Name="DbGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="False" SelectionChanged="DbGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="PLC STRUCTURE" Binding="{Binding PlcStructure}" Width="170" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="PLC NAME" Binding="{Binding PlcName}" Width="220" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="SYSTEM NAME" Binding="{Binding SystemNameEnglish}" Width="220" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="NAME" Binding="{Binding NameEnglish}" Width="*" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="90" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="XREF MEAS ID" Binding="{Binding CrossReferenceMeasIdCount}" Width="105" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="XREF VAL" Binding="{Binding CrossReferenceValCount}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
