<Window x:Class="CwcConfigurator.App.DescriptionTextListsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Descriptions text lists"
        Width="1680"
        Height="620"
        MinWidth="980"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Descriptions text lists" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid x:Name="WorkbookRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Workbook" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="WorkbookPathBox" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Browse..." Width="86" Margin="8,0,0,0" Click="Browse_Click"/>
                <Button Grid.Column="3" Content="Load" Width="72" Margin="8,0,0,0" Click="Load_Click"/>
                <Button Grid.Column="4" Content="Save workbook" Width="116" Margin="8,0,0,0" Click="SaveWorkbook_Click"/>
            </Grid>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#57606A"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="PullFromLabel" DockPanel.Dock="Left" Text="Pull from:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <ComboBox x:Name="ScadaSourceCombo" DockPanel.Dock="Left" Width="170" VerticalAlignment="Center"
                      ItemsSource="{Binding ScadaSourceDevices}"
                      ToolTip="WinCC Unified device to pull the description text lists from. Pick the SCADA that has all units (typically the main one); lists are distributed to PLCs by name."/>
            <Button x:Name="PullFromTiaButton" DockPanel.Dock="Left" Content="Pull from TIA" Width="120" Margin="8,0,0,0" FontWeight="SemiBold" Click="PullFromTia_Click"/>
            <Button x:Name="PushToTiaButton" DockPanel.Dock="Left" Content="Push to TIA" Width="110" Margin="8,0,0,0" FontWeight="SemiBold" Click="PushToTia_Click"
                    ToolTip="Writes the descriptions of the PLC databases into TIA. Text lists that are library types (TIA 21+, Types/SCADA_TEXT_LIST) get a new released version only when their texts changed, and every SCADA is updated to it; other lists are imported into the device."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply descriptions" Width="132" Margin="0,0,8,0" Click="Apply_Click"/>
                <Button Content="OK" Width="86" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Close" Width="86" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="MappingGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  CellEditEnding="MappingGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PLC database" Binding="{Binding PlcName}" IsReadOnly="True" Width="*"/>
                <DataGridComboBoxColumn Header="ALM Description List"
                                        x:Name="AlmDescriptionListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding AlmDescriptionsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="PAR Description List"
                                        x:Name="ParDescriptionListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding ParDescriptionsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="Sequence Control Status Names"
                                        x:Name="SequenceControlStatusListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding SequenceControlStatusList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="Sequence Command Names"
                                        x:Name="SequenceCommandListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding SequenceCommandList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="ALM Blocking Class"
                                        x:Name="AlmBlockingClassListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding AlmBlockingClassList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="Cabinets"
                                        x:Name="CabinetsListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding CabinetsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="Port Configuration"
                                        x:Name="PortConfigurationListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding PortConfigurationList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="SEQ CMD"
                                        x:Name="SeqCmdListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding SeqCmdList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="SEQ CONFIG"
                                        x:Name="SeqConfigListColumn"
                                        Width="2*"
                                        SelectedItemBinding="{Binding SeqConfigList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
