<local:SettingsEditorViewBase x:Class="CwcConfigurator.App.Settings.TableDesignSettingsView"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:local="clr-namespace:CwcConfigurator.App">
    <local:SettingsEditorViewBase.Resources>
        <local:ColorValueToBrushConverter x:Key="TableDesignColorConverter"/>
        <Style x:Key="TdLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,10"/>
        </Style>
        <Style x:Key="TdSubLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
        <Style x:Key="TdCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TdColorCombo" TargetType="ComboBox" BasedOn="{StaticResource TdCombo}">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </local:SettingsEditorViewBase.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource TdLabel}"
                       Text="Table layout"
                       ToolTip="Color scheme for alternating spreadsheet rows."/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LayoutCombo" Style="{StaticResource TdCombo}" Margin="0,0,8,10"/>

            <TextBlock Grid.Row="1" Style="{StaticResource TdLabel}"
                       Text="Conditional cell coloring"
                       ToolTip="Master switch for the per-cell color overlays defined below."/>
            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ConditionalColoringCheck" Content="Enabled" VerticalAlignment="Center" Margin="0,0,8,14"/>
        </Grid>

        <Border Background="#FAFBFC" BorderBrush="#D0D7DE" BorderThickness="1" Padding="14,12" Margin="0,4,0,12" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="DB ALM — row colors by blocking class"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource TdSubLabel}" Text="In-use row (no specific class)"
                               ToolTip="Color for an alarm row marked in use when no blocking class is selected."/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DbAlmUsedColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="0" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbAlmUsedColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource TdSubLabel}" Text="Class: Alarm"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DbAlmAlarmColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="1" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbAlmAlarmColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>

                    <TextBlock Grid.Row="2" Style="{StaticResource TdSubLabel}" Text="Class: Start interlock"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DbAlmStartInterlockColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="2" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbAlmStartInterlockColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource TdSubLabel}" Text="Class: Normal shutdown"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DbAlmNormalShutdownColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="3" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbAlmNormalShutdownColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>

                    <TextBlock Grid.Row="4" Style="{StaticResource TdSubLabel}" Text="Class: Quick shutdown"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="DbAlmQuickShutdownColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="4" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbAlmQuickShutdownColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>

                    <TextBlock Grid.Row="5" Style="{StaticResource TdSubLabel}" Text="Class: Emergency shutdown"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="DbAlmEmergencyShutdownColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="5" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbAlmEmergencyShutdownColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="#FAFBFC" BorderBrush="#D0D7DE" BorderThickness="1" Padding="14,12" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="DB PAR — value cell colors"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource TdSubLabel}" Text="In-use row"
                               ToolTip="Color applied to the row when a DB PAR row is marked in use."/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DbParUsedColorCombo" Style="{StaticResource TdColorCombo}"/>
                    <Border Grid.Row="0" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbParUsedColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource TdSubLabel}" Text="Active value cell (I/T/R-VAL)"
                               Margin="0,0,12,0"
                               ToolTip="Color applied to whichever of I_VAL / T_VAL / R_VAL is active for the parameter type."/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DbParActiveValueColorCombo" Style="{StaticResource TdColorCombo}" Margin="0,0,8,0"/>
                    <Border Grid.Row="1" Grid.Column="2" Width="20" Height="20" BorderBrush="#B7C3D0" BorderThickness="1"
                            Background="{Binding ElementName=DbParActiveValueColorCombo, Path=Text, Converter={StaticResource TableDesignColorConverter}}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</local:SettingsEditorViewBase>
