<Window x:Class="CwcConfigurator.App.DbDiSystemSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB DI System Settings"
        Width="900"
        Height="560"
        MinWidth="900"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="DT prefix" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="StructPrefixBox" Grid.Column="1" Height="26" TextChanged="PrefixBox_TextChanged"/>
            <TextBlock x:Name="SimulatorPrefixLabel" Grid.Column="2" Text="Simulator DT prefix" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox x:Name="SimulatorPrefixBox" Grid.Column="3" Height="26" TextChanged="PrefixBox_TextChanged"/>
        </Grid>

        <DataGrid x:Name="SystemNamesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  CellEditEnding="SystemNamesGrid_CellEditEnding"
                  CurrentCellChanged="SystemNamesGrid_CurrentCellChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Width="70" Header="SYS NUM" Binding="{Binding SystemNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="*" Header="MEMBER / STRUCT NAME" Binding="{Binding SystemPlcShortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                <DataGridTextColumn Width="*" Header="PLC DT STRUCT" Binding="{Binding SystemPlcLongName}" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn x:Name="SimulatorColumn" Width="*" Header="SIMULATOR DT" Binding="{Binding SimulatorDataType}" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
