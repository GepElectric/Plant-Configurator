<UserControl x:Class="CwcConfigurator.App.SequenceDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:CwcConfigurator.Domain">
    <UserControl.Resources>
        <Style x:Key="SeqHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SeqPanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#087C96"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="SeqEditText" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="SeqSmallCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="SequenceStepItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="4,1,1,1"
                                Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF7FA"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#087C96"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF7FA"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#087C96"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock Text="Steps" Style="{StaticResource SeqHeader}" DockPanel.Dock="Top"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="number of steps" VerticalAlignment="Center" Width="120" FontWeight="SemiBold"/>
                <ComboBox x:Name="StepCountCombo"
                          Width="90"
                          Style="{StaticResource SeqSmallCombo}"
                          SelectionChanged="StepCountCombo_SelectionChanged"/>
            </StackPanel>

            <ListBox x:Name="StepsList"
                     BorderBrush="#D0D7DE"
                     ItemContainerStyle="{StaticResource SequenceStepItemStyle}"
                     SelectionChanged="StepsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:SequenceStepConfig}">
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#3B3B3B"
                                    CornerRadius="4"
                                    Margin="0,0,8,0"
                                    Height="58">
                                <TextBlock Text="{Binding StepNumber}"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SeqEditText}"
                                         Width="310"
                                         MaxLength="32"
                                         ToolTip="Step name ENG"
                                         TextAlignment="Center"/>
                                <TextBox Grid.Row="1"
                                         Margin="0,4,0,0"
                                         Text="{Binding NameOther, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SeqEditText}"
                                         Width="310"
                                         MaxLength="32"
                                         ToolTip="Step name Other"
                                         TextAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="SequenceTitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#24292F"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="SelectedStepText"
                           Foreground="#57606A"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <WrapPanel Grid.Row="0"
                       Margin="0,26,0,8"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right">
                <TextBlock Text="Copy step from" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CopySourceStepCombo" Width="210" Height="28" Margin="0,0,6,0"/>
                <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CopyTargetStepCombo" Width="210" Height="28" Margin="0,0,6,0"/>
                <Button Content="Copy step" Width="82" Height="28" Margin="0,0,12,0" Click="CopyStep_Click"/>
                <TextBlock Text="Swap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SwapStepACombo" Width="80" Height="28" Margin="0,0,6,0"/>
                <ComboBox x:Name="SwapStepBCombo" Width="80" Height="28" Margin="0,0,6,0"/>
                <Button Content="Swap step" Width="82" Height="28" Click="SwapStep_Click"/>
            </WrapPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="Step Conditions">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SeqPanelHeader}">
                                <TextBlock Text="Step Conditions"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ComboBox x:Name="ConditionCountCombo"
                                      Grid.Column="1"
                                      Width="176"
                                      Margin="8,0,0,0"
                                      Style="{StaticResource SeqSmallCombo}"
                                      SelectionChanged="ConditionCountCombo_SelectionChanged"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid MinHeight="420" Background="#FCF8FB">
                                <Grid x:Name="ConditionDiagramGrid"
                                      MinHeight="360"
                                      Margin="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Step Commands">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SeqPanelHeader}">
                                <TextBlock Text="Sequence commands"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ComboBox x:Name="CommandCountCombo"
                                      Grid.Column="1"
                                      Width="176"
                                      Margin="8,0,0,0"
                                      Style="{StaticResource SeqSmallCombo}"
                                      SelectionChanged="CommandCountCombo_SelectionChanged"/>
                        </Grid>
                        <DataGrid x:Name="CommandSlotsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="*" IsReadOnly="True"/>
                                <DataGridComboBoxColumn x:Name="CommandColumn"
                                                        Header="SEQ CMD"
                                                        SelectedValueBinding="{Binding CommandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Id"
                                                        DisplayMemberPath="Display"
                                                        Width="*"/>
                                <DataGridComboBoxColumn x:Name="CommandOnOffColumn"
                                                        Header="0 - OFF / 1 - ON"
                                                        SelectedValueBinding="{Binding On, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Value"
                                                        DisplayMemberPath="Display"
                                                        Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Margin="0,8,0,0"
                    Padding="8"
                    DataContext="{Binding SelectedItem, ElementName=StepsList}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Enter delay" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding EnterDelayTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SeqEditText}"/>
                    <TextBlock Grid.Column="2" Text="Duration" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SeqEditText}"/>
                    <TextBlock Grid.Column="4" Text="Exit delay" VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <TextBox Grid.Column="5" Text="{Binding ExitDelayTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SeqEditText}"/>
                    <CheckBox Grid.Column="6" Content="Duration check" IsChecked="{Binding DurationCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
