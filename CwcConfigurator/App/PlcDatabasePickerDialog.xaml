<Window x:Class="CwcConfigurator.App.PlcDatabasePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select PLC database"
        Width="420"
        Height="190"
        MinWidth="360"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="82" IsCancel="True"/>
            <Button Content="Apply" Width="82" Click="Apply_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="PromptText" Margin="0,0,0,6"/>
            <ComboBox x:Name="DatabaseCombo"
                      Height="26"
                      DisplayMemberPath="Name"
                      VerticalContentAlignment="Center"/>
            <CheckBox x:Name="CreateNewCheck" Content="Create new PLC database" Margin="0,12,0,4" Checked="CreateNewCheck_Changed" Unchecked="CreateNewCheck_Changed"/>
            <TextBox x:Name="NewNameText" Height="26" VerticalContentAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
