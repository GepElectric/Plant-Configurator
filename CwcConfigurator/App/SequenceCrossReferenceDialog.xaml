<Window x:Class="CwcConfigurator.App.SequenceCrossReferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sequence cross-reference"
        Width="1200"
        Height="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ID VARIABLE" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                    <TextBlock x:Name="IdCrossReferenceVariableText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="OpenIdTiaCrossReferenceButton"
                        Grid.Column="1"
                        Content="Open in TIA"
                        Width="120"
                        Height="32"
                        Margin="18,0,0,0"
                        VerticalAlignment="Top"
                        IsEnabled="False"
                        Click="OpenIdTiaCrossReferenceButton_Click"/>
            </Grid>
            <Border Grid.Row="1" Margin="0,10,0,8" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                <TextBlock x:Name="IdCrossReferenceSummaryText" FontSize="13" TextWrapping="Wrap"/>
            </Border>
            <DataGrid x:Name="IdCrossReferenceGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionChanged="IdCrossReferenceGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Block" Binding="{Binding BlockName}" Width="180"/>
                    <DataGridTextColumn Header="Network" Binding="{Binding Network}" Width="80"/>
                    <DataGridTextColumn Header="Reference location" Binding="{Binding ReferenceLocation}" Width="230"/>
                    <DataGridTextColumn Header="Reference type" Binding="{Binding ReferenceType}" Width="115"/>
                    <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="80"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="100"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="230"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VAL VARIABLE" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                    <TextBlock x:Name="ValCrossReferenceVariableText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="OpenValTiaCrossReferenceButton"
                        Grid.Column="1"
                        Content="Open in TIA"
                        Width="120"
                        Height="32"
                        Margin="18,0,0,0"
                        VerticalAlignment="Top"
                        IsEnabled="False"
                        Click="OpenValTiaCrossReferenceButton_Click"/>
            </Grid>
            <Border Grid.Row="1" Margin="0,10,0,8" Padding="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                <TextBlock x:Name="ValCrossReferenceSummaryText" FontSize="13" TextWrapping="Wrap"/>
            </Border>
            <DataGrid x:Name="ValCrossReferenceGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionChanged="ValCrossReferenceGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Block" Binding="{Binding BlockName}" Width="180"/>
                    <DataGridTextColumn Header="Network" Binding="{Binding Network}" Width="80"/>
                    <DataGridTextColumn Header="Reference location" Binding="{Binding ReferenceLocation}" Width="230"/>
                    <DataGridTextColumn Header="Reference type" Binding="{Binding ReferenceType}" Width="115"/>
                    <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="80"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="80"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="100"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="230"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
