<Window x:Class="CwcConfigurator.App.DbMeasInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB MEAS info"
        Width="1760"
        Height="980"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <TabControl x:Name="RootTabs">
            <TabItem Header="Meas to alarm">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="InfoCanvas" Width="1900" Height="900">
                        <Border Canvas.Left="600" Canvas.Top="18" Width="700" Height="54" Padding="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock x:Name="MeasurementText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <Rectangle Canvas.Left="740"
                                   Canvas.Top="82"
                                   Width="280"
                                   Height="790"
                                   Stroke="#1F2937"
                                   StrokeThickness="2"
                                   Fill="#F8FAFC"/>
                        <TextBlock Canvas.Left="810"
                                   Canvas.Top="110"
                                   Text="FB MEAS TO ALARM"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                    </Canvas>
                </Viewbox>
            </TabItem>
            <TabItem Header="Summery">
                <Grid Margin="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,18,0" Padding="20" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LOGGING" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock x:Name="LoggingText" TextWrapping="Wrap" FontSize="14" LineHeight="24"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="0,0,18,0" Padding="20" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MAPPING" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock x:Name="MappingText" TextWrapping="Wrap" FontSize="14" LineHeight="24"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="20" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TEXTS" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock x:Name="TextsText" TextWrapping="Wrap" FontSize="14" LineHeight="24"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
