<Window x:Class="CwcConfigurator.App.AlmParExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALM/PAR List Export"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Foreground" Value="#30363D"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="GenerateButton" Content="Generate Document" Width="170" Click="Generate_Click"/>
            <Button x:Name="CancelRunButton" Content="Cancel" Width="90" Click="CancelRun_Click" IsEnabled="False"/>
            <ProgressBar x:Name="Progress" Width="220" Height="22" Margin="8,4,8,0" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#57606A" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ALM/PAR List Export" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

                <TextBlock Text="Document Metadata" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Doc Number:" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="DocNumberText" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormInput}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Author:" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="AuthorText" Grid.Row="0" Grid.Column="4" Style="{StaticResource FormInput}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Date:" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="DateText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormInput}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="FB Number:" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="FbNumberText" Grid.Row="1" Grid.Column="4" Style="{StaticResource FormInput}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Plant Full Name:" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="PlantNameText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource FormInput}"/>
                </Grid>

                <TextBlock Text="Customer Block:" Margin="0,4,0,6" Foreground="#30363D"/>
                <TextBox x:Name="CustomerBlockText" MinHeight="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="PLC Selection And Exclusions" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Exclusions accept comma, semicolon, or new-line separated rules: 400, 400-500, &gt;400, &gt;=400, &lt;120, &lt;=120."
                           Foreground="#57606A"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <DataGrid x:Name="MappingGrid"
                          Height="190"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CellEditEnding="MappingGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Include" Binding="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridCheckBoxColumn Header="ALM" Binding="{Binding ExportAlm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridCheckBoxColumn Header="PAR" Binding="{Binding ExportPar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="PLC Name" Binding="{Binding PlcName}" IsReadOnly="True" Width="180"/>
                        <DataGridTextColumn Header="ALM Exclude IDs" Binding="{Binding AlmExcludeSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="PAR Exclude IDs" Binding="{Binding ParExcludeSpec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Export Options" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Language:" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Format:" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="PdfCheck" Content="PDF" Margin="0,4,16,0"/>
                        <CheckBox x:Name="DocxCheck" Content="DOCX" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output Folder:" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="OutputPathText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FormInput}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Width="92" Margin="8,0,0,8" Click="BrowseOutput_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
