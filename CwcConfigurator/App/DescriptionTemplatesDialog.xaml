<Window x:Class="CwcConfigurator.App.DescriptionTemplatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Description Templates"
        Width="980"
        Height="680"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Description Templates" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                <TextBox x:Name="SearchText" Width="220" Margin="0,0,12,6" TextChanged="SearchText_TextChanged"/>
                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                <ComboBox x:Name="ScopeFilter" Width="120" Margin="0,0,12,6" SelectionChanged="ScopeFilter_SelectionChanged"/>
                <Button Content="New" Width="78" Margin="0,0,8,6" Click="Add_Click"/>
                <Button Content="Delete" Width="78" Margin="0,0,8,6" Click="Delete_Click"/>
                <Button Content="Save" Width="78" Margin="0,0,8,6" Click="Save_Click"/>
                <Button Content="OK" Width="78" Margin="0,0,0,6" Click="Ok_Click"/>
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="230"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="TemplatesGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="TemplatesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="190"/>
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                    <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="Number of ALM/PAR descriptions currently using this template (all PLC databases)."/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Names ENG" Binding="{Binding TextEnglish}" Width="2*"/>
                    <DataGridTextColumn Header="Names other language" Binding="{Binding TextOther}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#D0D7DE"/>

            <Border Grid.Row="2" BorderBrush="#D0D7DE" BorderThickness="1" Background="#F6F8FA" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Template Editor" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="KeyText" Grid.Column="1" MinHeight="28"/>
                        <TextBlock Grid.Column="3" Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ScopeText" Grid.Column="4" MinHeight="28"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="ENG:" Margin="0,0,0,4"/>
                        <TextBox x:Name="EnglishText" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Other language:" Margin="0,0,0,4"/>
                        <TextBox x:Name="OtherText" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
