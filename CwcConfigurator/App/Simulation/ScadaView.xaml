<UserControl x:Class="CwcConfigurator.App.Simulation.ScadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Screen" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ListBox x:Name="ScreenTabs" SelectionChanged="ScreenTabs_SelectionChanged" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,3"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Button Content="New screen…" MinWidth="85" Height="24" Margin="10,0,4,0" Click="NewScreen_Click"/>
                    <Button Content="Rename…" MinWidth="65" Height="24" Margin="0,0,4,0" Click="RenameScreen_Click"/>
                    <Button Content="Delete" MinWidth="55" Height="24" Click="DeleteScreen_Click"
                            ToolTip="Deletes an empty screen (move its objects to another screen first)."/>
                    <ComboBox x:Name="AddTypeBox" Width="190" Height="24" Margin="16,0,4,0" DisplayMemberPath="Title"
                              ToolTip="Object type to add to this screen."/>
                    <Button Content="Add" MinWidth="45" Height="24" Click="AddObject_Click"
                            ToolTip="Add the chosen object to this screen (or right-click on the empty sheet: Add object here)."/>
                    <Button Content="Generate from signals" MinWidth="130" Height="24" Margin="8,0,0,0" Click="Generate_Click"
                            ToolTip="Create objects for this PLC from the signal names (gates, reservoir, HPU, nozzles, MIV, GCB, …) and bind their signals."/>
                    <CheckBox x:Name="SldCheck" Content="SLD screen" VerticalAlignment="Center" Margin="16,0,0,0"
                              Checked="SldCheck_Changed" Unchecked="SldCheck_Changed"
                              ToolTip="Draw this screen as a single-line diagram: busbars, breakers, contactors, disconnectors, earthing switches and motors as symbols."/>
                    <ToggleButton x:Name="ShowLinksToggle" Content="Show all links" MinWidth="100" Height="24" Margin="16,0,0,0"
                                  Checked="ShowLinks_Changed" Unchecked="ShowLinks_Changed"
                                  ToolTip="Off: only the links of the selected object (power lines are always shown). On: every link."/>
                </StackPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F3F4F6">
                <Canvas x:Name="Sheet" Width="1600" Height="1000" Background="#F3F4F6" MouseLeftButtonDown="Sheet_MouseLeftButtonDown" MouseRightButtonUp="Sheet_MouseRightButtonUp"
                        MouseMove="Sheet_MouseMove" MouseLeftButtonUp="Sheet_MouseLeftButtonUp"/>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E5E7EB"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Text="Select an object"/>
                <TextBlock x:Name="SubtitleText" Foreground="#57606A" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Click an object on the plant sheet to set its parameters and force its outputs. Drag objects to arrange the sheet."/>

                <StackPanel x:Name="ObjectPanel" Visibility="Collapsed">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Screen" VerticalAlignment="Center" ToolTip="Move the object to another SCADA screen."/>
                        <ComboBox x:Name="ObjectScreenBox" Grid.Column="1" Height="24" SelectionChanged="ObjectScreenBox_SelectionChanged"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Also on" VerticalAlignment="Top" Margin="0,2,0,0"
                                   ToolTip="Show the same object on more screens, e.g. a contactor next to its pump and in the cabinet SLD."/>
                        <ItemsControl x:Name="AlsoOnList" Grid.Column="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                    <ItemsControl x:Name="OptionsList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding Value}" Height="24"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Parameters" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <DataGrid x:Name="ParamsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PARAMETER" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="VALUE" Width="80" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTextColumn Header="UNIT" Width="55" Binding="{Binding Unit}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <TextBlock Text="Outputs (tick FORCE to hold a value)" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <DataGrid x:Name="ForcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OUTPUT" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="VALUE" Width="90" Binding="{Binding Live}" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="FORCE" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Forced, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TO" Width="60" Binding="{Binding ForceValue, UpdateSourceTrigger=LostFocus}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
