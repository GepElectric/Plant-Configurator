                                                        <Setter Property="Stroke" Value="#D0D7DE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TiaSyncVisualState}" Value="InSync">
                                                                <Setter Property="Fill" Value="#2DA44E"/>
                                                                <Setter Property="Stroke" Value="#1A7F37"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TiaSyncVisualState}" Value="Differs">
                                                                <Setter Property="Fill" Value="#CF222E"/>
                                                                <Setter Property="Stroke" Value="#A40E26"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Setter Property="Foreground" Value="#24292F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="#111827"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TiaOnlineState}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11">
