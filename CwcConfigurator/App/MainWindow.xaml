              Esc closes. Search is per-cell on the currently active grid.
            -->
            <Border x:Name="FindReplaceBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,16,0"
                    Padding="8"
                    Background="White"
                    BorderBrush="#8C959F"
                    BorderThickness="1"
                    CornerRadius="4"
                    Panel.ZIndex="100">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindInput"
                                 Width="240"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 TextChanged="FindInput_TextChanged"
                                 KeyDown="FindInput_KeyDown"
