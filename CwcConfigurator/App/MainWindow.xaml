                                                    <Separator/>
                                                    <MenuItem Header="TIA go online" Click="PlcDatabaseGoOnline_Click"/>
                                                    <MenuItem Header="TIA go offline" Click="PlcDatabaseGoOffline_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="TIA pull whole database" Click="PullSelectedPlcDatabaseFromTia_Click"/>
                                                    <MenuItem Header="TIA push whole database" Click="PushSelectedPlcDatabaseToTia_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Validate" Click="ValidateProject_Click"/>
                                                    <MenuItem Header="Generate DB source files" Click="GenerateFiles_Click"/>
                                                    <MenuItem Header="Export one PLC to Excel..." Click="ExportOnePlcToExcel_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete" Click="DeletePlcDatabase_Click"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </DockPanel>
