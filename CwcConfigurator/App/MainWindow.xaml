                        <Button x:Name="TabImportTextButton" Content="Import text" Margin="4,0,0,0" Click="ActiveDbImportText_Click" Visibility="Collapsed"/>
                        <Button x:Name="TabTiaPullButton" Content="Pull" Margin="8,0,0,0" Click="ActiveDbPull_Click" Visibility="Collapsed"/>
