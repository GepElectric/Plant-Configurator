<Window x:Class="CwcConfigurator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:CwcConfigurator.Domain"
        xmlns:local="clr-namespace:CwcConfigurator.App"
        Title="Plant Configurator"
        Width="1360"
        Height="860"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveProjectAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.ValidateProjectCommand}"/>
        <KeyBinding Key="F6" Command="{x:Static local:MainWindow.GenerateFilesCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{x:Static local:MainWindow.OpenReplaceCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewProjectCommand}" Executed="NewProjectCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.OpenProjectCommand}" Executed="OpenProjectCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveProjectCommand}" Executed="SaveProjectCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveProjectAsCommand}" Executed="SaveProjectAsCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="UndoCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="RedoCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.ValidateProjectCommand}" Executed="ValidateProjectCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.GenerateFilesCommand}" Executed="GenerateFilesCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.FocusSearchCommand}" Executed="FocusSearchCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.OpenReplaceCommand}" Executed="OpenReplaceCommand_Executed"/>
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>
        <local:ColorValueToBrushConverter x:Key="ColorValueToBrushConverter"/>
        <local:ValidationValueDisplayConverter x:Key="ValidationValueDisplayConverter"/>
        <local:ModuleNameDisplayConverter x:Key="ModuleNameDisplayConverter"/>
        <local:AlarmReferenceDisplayConverter x:Key="AlarmReferenceDisplayConverter"/>
        <local:AlarmIdReferenceDisplayConverter x:Key="AlarmIdReferenceDisplayConverter"/>
        <local:BooleanNumberDisplayConverter x:Key="BooleanNumberDisplayConverter"/>
        <local:ParameterReferenceDisplayConverter x:Key="ParameterReferenceDisplayConverter"/>
        <local:DbConditionalCellBrushConverter x:Key="DbConditionalCellBrushConverter"/>
        <local:ReadOnlyForegroundConverter x:Key="ReadOnlyForegroundConverter"/>
        <local:DescriptionTemplateTooltipConverter x:Key="DescriptionTemplateTooltipConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="DataGridCell">
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <EventSetter Event="MouseEnter" Handler="DataGridCell_MouseEnter"/>
            <EventSetter Event="MouseMove" Handler="DataGridCell_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="DataGridCell_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid>
                            <Border x:Name="TableDesignLayer">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource DbConditionalCellBrushConverter}" ConverterParameter="TABLE">
                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="(ItemsControl.AlternationIndex)"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                            <Border x:Name="RowConditionalLayer"
                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                            <Border x:Name="CellConditionalLayer"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="CellBorder"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <TextElement.Foreground>
                                        <MultiBinding Converter="{StaticResource ReadOnlyForegroundConverter}">
                                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridCell}" Path="IsReadOnly"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" Path="Background"/>
                                        </MultiBinding>
                                    </TextElement.Foreground>
                                </ContentPresenter>
                            </Border>
                            <Rectangle x:Name="AutoFillHandle"
                                       Width="6"
                                       Height="6"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,1,1"
                                       Fill="#107C41"
                                       Stroke="#107C41"
                                       StrokeThickness="1"
                                       Visibility="Collapsed"/>
                            <Rectangle x:Name="ClipboardMarker"
                                       Stroke="#107C41"
                                       StrokeThickness="2"
                                       StrokeDashArray="3,2"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <Rectangle x:Name="ProblemMarker"
                                       Stroke="#D1242F"
                                       StrokeThickness="2"
                                       Fill="Transparent"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#8C959F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#107C41"/>
                                <Setter TargetName="CellBorder" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <!--
                                  Subtle "not editable" cue: italic only. The muted vs
                                  dark foreground is chosen by ReadOnlyForegroundConverter
                                  on the ContentPresenter so the text stays legible on
                                  conditionally coloured rows (signal / DB ALM / DB PAR).
                                -->
                                <Setter Property="FontStyle" Value="Italic"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Tag" Value="CanAutoFill"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#107C41"/>
                                <Setter TargetName="CellBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="AutoFillHandle" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="local:SpreadsheetCellMarker.IsProblemCell" Value="True">
                                <Setter TargetName="ProblemMarker" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="local:SpreadsheetCellMarker.IsClipboardCopied" Value="True">
                                <Setter TargetName="ClipboardMarker" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="MarchingAntsStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ClipboardMarker"
                                                             Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="0"
                                                             To="-5"
                                                             Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="MarchingAntsStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DbParIntegerValueCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource DbConditionalCellBrushConverter}" ConverterParameter="I_VAL">
                        <Binding/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DbParTimeValueCell" TargetType="DataGridCell" BasedOn="{StaticResource DbParIntegerValueCell}">
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource DbConditionalCellBrushConverter}" ConverterParameter="T_VAL">
                        <Binding/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DbParRealValueCell" TargetType="DataGridCell" BasedOn="{StaticResource DbParIntegerValueCell}">
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource DbConditionalCellBrushConverter}" ConverterParameter="R_VAL">
                        <Binding/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SignalConfigRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource DbConditionalCellBrushConverter}" ConverterParameter="SIGNAL_ROW">
                        <Binding/>
                        <Binding Path="HasValidationError"/>
                        <Binding Path="Config"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DbTableBaseRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredEditCombo" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TemplateMatchedDescriptionText" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="Bold"/>
            <!-- Bold cells hold a template KEY, not the final text; the tooltip
                 shows what the template will actually generate. -->
            <Setter Property="ToolTip" Value="{Binding DescriptionTemplateKey, Converter={StaticResource DescriptionTemplateTooltipConverter}}"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DescriptionTemplateKey}" Value="">
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModuleSlicer" TargetType="ListBox">
            <Setter Property="MinWidth" Value="600"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="BorderBrush" Value="#B7C3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#B7C3D0"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6EA8FE"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#BFD7FF"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2F6FED"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            Column-visibility slicer used at the top of every DB tab. Same look
            as the module slicer (Excel-style pill row, accent on selection)
            but without the 600 px minimum width so each tab can size its row
            to fit its own column groups.
        -->
        <Style x:Key="ColumnSlicer" TargetType="ListBox" BasedOn="{StaticResource ModuleSlicer}">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!--
            Cell + header styles applied to the LAST frozen column on every DB
            grid to visually delimit the frozen region from the scrolling area
            (Excel-like vertical separator). 2-px dark right border keeps the
            cue visible on top of the conditional-coloring layer.
        -->
        <Style x:Key="FrozenSeparatorCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderThickness" Value="0,0,2,0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
        </Style>
        <Style x:Key="FrozenSeparatorHeader" TargetType="DataGridColumnHeader">
            <Setter Property="BorderThickness" Value="0,0,2,0"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="MainMenuBar" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="_Open project..." InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                <MenuItem Header="_Close Project" Click="CloseProject_Click"/>
                <MenuItem Header="Import database from _Excel..." Click="ImportExcel_Click"/>
                <Separator/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Validate" InputGestureText="F5" Click="ValidateProject_Click"
                          ToolTip="Checks project data before generation: ID ranges, duplicate IDs, invalid validation-list values, text lengths and database consistency."/>
                <MenuItem Header="_Generate DB source files" InputGestureText="F6" Click="GenerateFiles_Click"/>
                <Separator/>
                <MenuItem Header="Export _Project Summary" Click="ExportSummary_Click"/>
                <MenuItem Header="ALM/PAR List PDF Exporter..." Click="AlmParExport_Click"/>
                <Separator/>
                <MenuItem Header="_WinCC">
                    <MenuItem Header="WinCC Tag Browser..." Click="OpenTagBrowser_Click"/>
                    <MenuItem Header="Import WinCC Unified JS Connector..." Click="ImportUnifiedJsConnector_Click"/>
                    <MenuItem Header="Test WinCC Unified script connection..." Click="TestUnifiedJsConnector_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Descriptions">
                <MenuItem Header="Import text list from TIA Portal exported Excel..." Click="DescriptionTextLists_Click"/>
                <MenuItem Header="Export text list to TIA Portal Excel..." Click="ExportDescriptionTextLists_Click"/>
                <Separator/>
                <MenuItem Header="Export DB Text Workbook..." Click="ExportAllDbText_Click"/>
                <MenuItem Header="Import DB Text Workbook..." Click="ImportAllDbText_Click"/>
                <Separator/>
                <MenuItem Header="Template Editor..." Click="DescriptionTemplates_Click"/>
                <MenuItem Header="Import templates from Excel..." Click="ImportDescriptionTemplates_Click"/>
                <MenuItem Header="Export templates to Excel..." Click="ExportDescriptionTemplates_Click"/>
            </MenuItem>
            <MenuItem Header="_TIA Sync" Click="TiaSync_Click"/>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Project Settings..." Click="SettingsHub_Click"
                          ToolTip="Open the Project Settings hub — single window with descriptions for every settings group."/>
                <Separator/>
                <MenuItem Header="_Validation &amp; Colors"
                          ToolTip="Per-column validation values, text length limits, conditional row/cell colors.">
                    <MenuItem Header="DB DI" Click="DbDiAdvancedSettings_Click"/>
                    <MenuItem Header="DB DO" Click="DbDoAdvancedSettings_Click"/>
                    <MenuItem Header="DB AO" Click="DbAoAdvancedSettings_Click"/>
                    <MenuItem Header="DB MEAS" Click="DbMeasAdvancedSettings_Click"/>
                    <MenuItem Header="DB PAR" Click="DbParAdvancedSettings_Click"/>
                    <MenuItem Header="DB ALM" Click="DbAlmAdvancedSettings_Click"/>
                </MenuItem>
                <MenuItem Header="_PLC Names &amp; Types"
                          ToolTip="System name rows + PLC struct / simulator type prefixes used during generation.">
                    <MenuItem Header="DB DI" Click="DbDiSettings_Click"/>
                    <MenuItem Header="DB DO" Click="DbDoSettings_Click"/>
                    <MenuItem Header="DB MEAS" Click="DbMeasSettings_Click"/>
                    <MenuItem Header="DB AO" Click="DbAoSettings_Click"/>
                    <MenuItem Header="DB ALM" Click="DbAlmSettings_Click"/>
                    <MenuItem Header="DB PAR" Click="DbParSettings_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="DB Names and Numbers" Click="DbDataBlockSettings_Click"/>
                <MenuItem Header="Project Paths" Click="ProjectPathsSettings_Click"/>
                <MenuItem Header="Table Design" Click="TableDesignSettings_Click"/>
                <MenuItem x:Name="MultilingualMenuItem" Header="Bilingual (validate *Other text fields)" IsCheckable="True" Click="MultilingualMenuItem_Click"
                          ToolTip="When unchecked, repair/validation warnings skip every *Other field (NameOther, DescriptionOther, SystemNameOther)."/>
            </MenuItem>
        </Menu>

        <Border x:Name="MainToolbar"
                DockPanel.Dock="Top"
                BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1"
                Background="#FAFBFC"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ToolbarNewButton" Click="NewProject_Click" ToolTip="New project (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="New" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarOpenButton" Click="OpenProject_Click" ToolTip="Open project (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Open" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarSaveButton" Click="SaveProject_Click" ToolTip="Save project (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Margin="8,2" Width="1" Background="#D0D7DE"/>
                <Button x:Name="ToolbarUndoButton" Click="Undo_Click" ToolTip="Undo last change (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Undo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarRedoButton" Click="Redo_Click" ToolTip="Redo last undone change (Ctrl+Y)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Redo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Margin="8,2" Width="1" Background="#D0D7DE"/>
                <Button x:Name="ToolbarValidateButton" Click="ValidateProject_Click" ToolTip="Validate project (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Validate" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarGenerateButton" Click="GenerateFiles_Click" ToolTip="Generate DB source files (F6)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Generate" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Margin="8,2" Width="1" Background="#D0D7DE"/>
                <Button x:Name="ToolbarTiaSyncButton" Click="TiaSync_Click" ToolTip="Open TIA Sync dialog">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TIA Sync" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarSettingsButton" Click="SettingsHub_Click" ToolTip="Open Project Settings hub">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Margin="8,2" Width="1" Background="#D0D7DE"/>
                <Button x:Name="ToolbarFindButton" Command="{x:Static local:MainWindow.FocusSearchCommand}" ToolTip="Find (Ctrl+F)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Find" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ToolbarReplaceButton" Command="{x:Static local:MainWindow.OpenReplaceCommand}" ToolTip="Replace (Ctrl+H)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE13E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Replace" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusActiveDbText" Foreground="#57606A" Text=""/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusRowCountsText" Foreground="#57606A" Text=""/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusSelectionText" Foreground="#0969DA" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusDirtyText" Foreground="#B45309" FontWeight="SemiBold" Text=""/>
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="ProblemsPane" DockPanel.Dock="Bottom" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Background="#FFFDF7" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FFF1DC" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Problems" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <RadioButton x:Name="ProblemsFilterAll" GroupName="ProblemsFilter" Content="All" IsChecked="True" Margin="0,0,8,0" Checked="ProblemsFilter_Changed"/>
                            <RadioButton x:Name="ProblemsFilterErrors" GroupName="ProblemsFilter" Content="Errors" Margin="0,0,8,0" Checked="ProblemsFilter_Changed"/>
                            <RadioButton x:Name="ProblemsFilterWarnings" GroupName="ProblemsFilter" Content="Warnings" Checked="ProblemsFilter_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="ProblemsCountText" Grid.Column="2" Margin="16,0,0,0" Foreground="#57606A" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Revalidate" MinHeight="22" Padding="8,1" Click="ValidateProject_Click" ToolTip="Run validation again (F5)"/>
                            <Button Content="Copy all" MinHeight="22" Padding="8,1" Margin="4,0,0,0" Click="ProblemsCopyAll_Click" ToolTip="Copy all issues to clipboard"/>
                            <Button Content="Hide" MinHeight="22" Padding="8,1" Margin="4,0,0,0" Click="ProblemsHide_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ListView x:Name="ProblemsList" Height="180" BorderThickness="0"
                          MouseDoubleClick="ProblemsList_MouseDoubleClick"
