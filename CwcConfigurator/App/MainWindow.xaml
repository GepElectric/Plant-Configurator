                        <ToggleButton x:Name="FindWholeWordToggle" Content="W" Width="32" Margin="4,0,0,0"
                                      Click="FindOptions_Changed" ToolTip="Whole word"/>
                        <Button Content="↑" Width="28" Margin="8,0,0,0" Click="FindPrevious_Click" ToolTip="Previous match (Shift+Enter)"/>
                        <Button Content="↓" Width="28" Click="FindNext_Click" ToolTip="Next match (Enter)"/>
                        <TextBlock x:Name="FindMatchCountText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#57606A" MinWidth="80"/>
                        <ToggleButton x:Name="ToggleReplaceModeButton"
                                      Content="Replace…"
                                      Margin="8,0,0,0"
                                      Padding="6,2"
                                      Click="ToggleReplaceMode_Click"
                                      ToolTip="Show replace input (Ctrl+H)"/>
                        <Button Content="✕" Width="28" Margin="8,0,0,0" Click="FindClose_Click" ToolTip="Close (Esc)"/>
                    </StackPanel>
                    <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBox x:Name="ReplaceInput"
                                 Width="240"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ReplaceInput_KeyDown"
                                 ToolTip="Replace text"/>
                        <Button Content="Replace" Margin="8,0,0,0" Click="Replace_Click" ToolTip="Replace current match"/>
                        <Button Content="Replace All" Click="ReplaceAll_Click" ToolTip="Replace every match in this table"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
            </Grid>

            <Border x:Name="WelcomeOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="White"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="0,0,1,0">
                        <DockPanel Margin="32,40,32,32">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Recent projects"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"/>
                            <TextBlock x:Name="WelcomeNoRecentText"
                                       DockPanel.Dock="Top"
                                       Text="No recent projects yet."
                                       Foreground="#57606A"
                                       Visibility="Collapsed"/>
                            <ListBox x:Name="WelcomeRecentList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MouseDoubleClick="WelcomeRecentList_MouseDoubleClick"
                                     KeyDown="WelcomeRecentList_KeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Path}"
                                                       Foreground="#57606A"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="48,72,48,32" VerticalAlignment="Top">
                        <TextBlock Text="Plant Configurator" FontSize="36" FontWeight="Light"/>
                        <TextBlock Text="Open an existing project or start a new one."
                                   Foreground="#57606A"
                                   FontSize="14"
                                   Margin="0,4,0,40"/>
                        <Button Content="New project"
                                HorizontalAlignment="Left"
                                MinWidth="260"
                                MinHeight="40"
                                Padding="16,8"
                                FontSize="14"
                                Margin="0,0,0,10"
                                Click="WelcomeNew_Click"/>
                        <Button Content="Open project..."
                                HorizontalAlignment="Left"
                                MinWidth="260"
                                MinHeight="40"
                                Padding="16,8"
                                FontSize="14"
                                Margin="0,0,0,10"
                                Click="WelcomeOpen_Click"/>
                        <Button Content="Import database from Excel..."
                                HorizontalAlignment="Left"
                                MinWidth="260"
                                MinHeight="40"
                                Padding="16,8"
                                FontSize="14"
                                Margin="0,0,0,10"
                                Click="WelcomeImportExcel_Click"/>
                        <TextBlock Text="Tip: pick a recent project from the list on the left, or browse with Open."
                                   Foreground="#57606A"
                                   FontSize="11"
                                   Margin="0,24,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="BusyOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="#A0FFFFFF"
                    Visibility="Collapsed"
                    Panel.ZIndex="200">
                <Border Background="White"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="32,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel MinWidth="260">
                        <TextBlock x:Name="BusyOverlayText"
                                   Text="Working..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="240"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="ToastHost"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,20"
                    Background="#E6323232"
                    CornerRadius="6"
                    Padding="14,9"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="300">
                <TextBlock x:Name="ToastText"
                           Foreground="White"
                           FontSize="12.5"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>


