                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="#57606A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TiaOnlineState}" Value="Online">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Foreground" Value="#1A7F37"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TiaOnlineState}" Value="Offline">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Foreground" Value="#57606A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename" Click="RenamePlcDatabase_Click"/>
                                                    <MenuItem Header="Copy" Click="CopyPlcDatabase_Click"/>
