<Window x:Class="CwcConfigurator.App.EplanDictionaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automap dictionary"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Restore default words" Padding="10,0" Margin="0,0,12,0" Click="RestoreDefaults_Click"
                    ToolTip="Adds the built-in abbreviations and synonyms that are missing; your own entries stay."/>
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Abbreviations and synonyms"/>
                <TextBlock DockPanel.Dock="Top" Foreground="#57606A" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Whole words, case does not matter. CB means CIRCUIT BREAKER, FASTER means UP. Applied to the schematic name and to the DB name."/>
                <DataGrid x:Name="SynonymGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="WORDS" Binding="{Binding Words}" Width="*"/>
                        <DataGridTextColumn Header="MEANS" Binding="{Binding Means}" Width="1.6*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Learned names"/>
                <TextBlock DockPanel.Dock="Top" Foreground="#57606A" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Links you confirmed in Automap although the names differ. They are always exact. Delete a row (Del) to forget it."/>
                <DataGrid x:Name="LearnedGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SCHEMATIC NAME" Binding="{Binding SchematicName}" Width="*"/>
                        <DataGridTextColumn Header="DB NAME (ENG)" Binding="{Binding DbName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
