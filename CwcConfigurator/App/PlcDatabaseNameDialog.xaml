<Window x:Class="CwcConfigurator.App.PlcDatabaseNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC database"
        Width="440"
        Height="170"
        MinWidth="400"
        MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="82" IsCancel="True"/>
            <Button Content="Apply" Width="82" Click="Apply_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="PLC database name" Margin="0,0,0,6"/>
            <TextBox x:Name="NameText" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
        </StackPanel>
    </DockPanel>
</Window>
