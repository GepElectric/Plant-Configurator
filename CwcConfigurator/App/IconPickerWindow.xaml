<Window x:Class="CwcConfigurator.App.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose icon" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Height="24" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter by icon id or graphic name."/>
        </DockPanel>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Foreground="#57606A" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="IconList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="IconList_MouseDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="118" Height="104" Padding="4" ToolTip="{Binding Graphic}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="52" Height="52" Background="#F3F4F6" CornerRadius="4">
                                <Grid>
                                    <Image Source="{Binding Image}" Width="44" Height="44" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Placeholder}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="18"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding IdText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Graphic}" FontSize="10.5" Foreground="#57606A" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
