<Window x:Class="CwcConfigurator.App.DbAdvancedSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CwcConfigurator.App"
        Title="DB Settings"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:ColorValueToBrushConverter x:Key="ColorValueToBrushConverter"/>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="ColorPaletteTemplate">
            <Border Background="{Binding Converter={StaticResource ColorValueToBrushConverter}}"
                    BorderBrush="#B7C3D0"
                    BorderThickness="1"
                    Padding="4,2">
                <TextBlock Text="{Binding}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <TabControl>
            <TabItem x:Name="ColorsTab" Header="Colors">
                <DataGrid x:Name="ColorsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          CanUserSortColumns="False"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="90" Header="INTEGER" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                        <DataGridTextColumn Width="*" Header="COLOR NAME" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                        <DataGridTemplateColumn Width="180" Header="COLOR">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Color, Converter={StaticResource ColorValueToBrushConverter}}"
                                            BorderBrush="#B7C3D0"
                                            BorderThickness="1"
                                            Padding="4,2">
                                        <TextBlock Text="{Binding Color}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              DropDownOpened="ColorCombo_DropDownOpened"
                                              ItemTemplate="{StaticResource ColorPaletteTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Text Lengths">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="STATUS SYSTEM ENG" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="SystemEngMaxText" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="STATUS NAME ENG" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="NameEngMaxText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="STATUS SYSTEM OTHER" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="SystemOtherMaxText" Grid.Row="2" Grid.Column="1" Style="{StaticResource CenteredEditText}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Text="STATUS NAME OTHER" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="NameOtherMaxText" Grid.Row="3" Grid.Column="1" Style="{StaticResource CenteredEditText}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Validation Lists">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add field" Width="92" Click="AddValidationField_Click"/>
                            <Button Content="Delete field" Width="92" Click="DeleteValidationField_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="ValidationGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False"
                                  SelectionChanged="ValidationGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="150" Header="KEY" Binding="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                                <DataGridTextColumn Width="*" Header="SETTING" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add value" Width="92" Click="AddValidationValue_Click"/>
                            <Button Content="Delete value" Width="92" Click="DeleteValidationValue_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="ValidationOptionsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="90" Header="VALUE" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                                <DataGridTextColumn Width="*" Header="NAME" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCellText}" EditingElementStyle="{StaticResource CenteredEditText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Conditional Colors" Visibility="Collapsed">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="DB ALM fallback" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbAlmUsedColorCombo" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="ALM class Alarm" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbAlmAlarmColorCombo" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="ALM class Start interlock" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbAlmStartInterlockColorCombo" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Text="ALM class Normal shutdown" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbAlmNormalShutdownColorCombo" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Text="ALM class Quick shutdown" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbAlmQuickShutdownColorCombo" Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="5" Text="ALM class Emergency shutdown" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbAlmEmergencyShutdownColorCombo" Grid.Row="5" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="6" Text="DB PAR IN USE row" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="DbParUsedColorCombo" Grid.Row="6" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="7" Text="DB PAR active value" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DbParActiveValueColorCombo" Grid.Row="7" Grid.Column="1" ItemsSource="{Binding ColorPalette, RelativeSource={RelativeSource AncestorType=Window}}" IsEditable="True" DropDownOpened="ColorCombo_DropDownOpened"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
