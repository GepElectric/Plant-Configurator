<Window x:Class="CwcConfigurator.App.TableDesignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Table Design"
        Width="520"
        Height="470"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Table layout" VerticalAlignment="Center" Margin="0,0,8,10"/>
            <ComboBox x:Name="LayoutCombo" Grid.Column="1" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Text="Conditional coloring" VerticalAlignment="Center" Margin="0,0,8,14"/>
            <CheckBox x:Name="ConditionalColoringCheck" Grid.Row="1" Grid.Column="1" Content="Enabled" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="2" Text="DB ALM fallback" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbAlmUsedColorCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="3" Text="ALM class Alarm" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbAlmAlarmColorCombo" Grid.Row="3" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="4" Text="ALM class Start interlock" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbAlmStartInterlockColorCombo" Grid.Row="4" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Text="ALM class Normal shutdown" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbAlmNormalShutdownColorCombo" Grid.Row="5" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="6" Text="ALM class Quick shutdown" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbAlmQuickShutdownColorCombo" Grid.Row="6" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="7" Text="ALM class Emergency shutdown" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbAlmEmergencyShutdownColorCombo" Grid.Row="7" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="8" Text="DB PAR in-use row" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="DbParUsedColorCombo" Grid.Row="8" Grid.Column="1" IsEditable="True" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="9" Text="DB PAR active value" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="DbParActiveValueColorCombo" Grid.Row="9" Grid.Column="1" IsEditable="True"/>
        </Grid>
    </DockPanel>
</Window>
