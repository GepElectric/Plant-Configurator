<Window x:Class="CwcConfigurator.App.DbDiPlcDefinitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC Definition Name"
        Width="560"
        Height="220"
        MinWidth="480"
        MinHeight="180"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="RowTitleText" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="RowSubtitleText" Foreground="#57606A" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PLC DEFINITION NAME" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="PlcDefinitionNameText" Grid.Column="1" Style="{StaticResource CenteredEditText}"/>
        </Grid>
    </DockPanel>
</Window>
