<Window x:Class="CwcConfigurator.App.DigitalInputConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Configuration"
        Width="980"
        Height="640"
        MinWidth="840"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredEditText" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="RowTitleText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RowSubtitleText" Foreground="#57606A" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Config" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ConfigCombo"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="ID" Margin="0,0,0,4"/>
                    <TextBox x:Name="SelectedIdText"
                             Style="{StaticResource CenteredEditText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="0,10,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DbSlicerLabel" Text="DB slicer" VerticalAlignment="Center"/>
                <TextBox x:Name="DbDiSlicerText"
                         Grid.Column="1"
                         TextChanged="DbDiSlicerText_TextChanged"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="Reset filter"
                        Margin="8,0,0,0"
                        Click="ResetFilters_Click"/>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="IdFilter"
                      SelectionChanged="ColumnFilter_SelectionChanged"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="0,0,3,0"/>
            <ComboBox x:Name="PlcStructureFilter"
                      Grid.Column="1"
                      SelectionChanged="ColumnFilter_SelectionChanged"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="3,0"/>
            <ComboBox x:Name="PlcNameFilter"
                      Grid.Column="2"
                      SelectionChanged="ColumnFilter_SelectionChanged"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="3,0"/>
            <ComboBox x:Name="SystemNameFilter"
                      Grid.Column="3"
                      SelectionChanged="ColumnFilter_SelectionChanged"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="3,0"/>
            <ComboBox x:Name="NameFilter"
                      Grid.Column="4"
                      SelectionChanged="ColumnFilter_SelectionChanged"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="3,0,0,0"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>

        <DataGrid x:Name="DbDiGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="False"
                  SelectionChanged="DbDiGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="PLC STRUCTURE" Binding="{Binding PlcStructure}" Width="170" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="PLC NAME" Binding="{Binding PlcName}" Width="220" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="SYSTEM NAME" Binding="{Binding SystemNameEnglish}" Width="220" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="NAME" Binding="{Binding NameEnglish}" Width="*" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="XREF ID" Binding="{Binding CrossReferenceIdCount}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
                <DataGridTextColumn Header="XREF VAL" Binding="{Binding CrossReferenceValCount}" Width="80" ElementStyle="{StaticResource CenteredCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
