<Window x:Class="CwcConfigurator.App.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sim="clr-namespace:CwcConfigurator.App.Simulation"
        Title="Simulator"
        Width="1400"
        Height="880"
        MinWidth="1000"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SetButton" TargetType="Button">
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- PLC connection and model control -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Background="#F6F8FA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="PLC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PlcSelector" Width="170" SelectionChanged="PlcSelector_SelectionChanged"/>
                    <TextBlock Text="IP" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <TextBox x:Name="IpBox" Width="115" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Rack" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <TextBox x:Name="RackBox" Width="30" VerticalContentAlignment="Center" Text="0"/>
                    <TextBlock Text="Slot" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <TextBox x:Name="SlotBox" Width="30" VerticalContentAlignment="Center" Text="1"/>
                    <TextBlock Text="DB" VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <TextBox x:Name="DbBox" Width="42" VerticalContentAlignment="Center" Text="30"/>
                    <Button x:Name="ConnectButton" Content="Connect" MinWidth="95" Height="26" Margin="12,0,0,0" Click="ConnectButton_Click"/>
                    <Ellipse x:Name="ConnectionLamp" Width="12" Height="12" Margin="10,0,6,0" Fill="#C9CED6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnectionText" Text="Not connected" VerticalAlignment="Center" Foreground="#57606A"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PlcStatusText" VerticalAlignment="Center" Foreground="#57606A" Margin="0,0,14,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="RunButton" Content="▶ Run model" MinWidth="110" Height="28" FontWeight="SemiBold" Click="RunButton_Click"
                            ToolTip="Run the plant model: it reads the PLC outputs (DO/AO) and writes the simulated inputs (DI/AI/RTD/COUNTER). Runs also without a PLC connection."/>
                    <Button Content="Reset" MinWidth="60" Height="28" Margin="6,0,0,0" Click="ResetButton_Click"
                            ToolTip="Back to the initial state (valves closed, pressures 0, standstill) and remove all forces."/>
                    <TextBlock x:Name="SimTimeText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#57606A" MinWidth="70"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- status -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Background="#F6F8FA">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
                <TextBlock x:Name="LayoutText" Foreground="#57606A" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="0,4,0,0">
            <TabItem Header="  Signals  ">
                <DockPanel>
                    <!-- simulator DB layout = PLC constants -->
                    <Border DockPanel.Dock="Top" Padding="10,4" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                        <Expander x:Name="LayoutExpander" Header="Simulator DB layout (PLC constants from the TIA tag table)">
                            <StackPanel Margin="0,6,0,2">
                                <WrapPanel x:Name="ConstantsPanel"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Apply layout" MinWidth="110" Height="26" Click="ApplyLayout_Click"/>
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#57606A" TextWrapping="Wrap"
                                               Text="Values as in TIA (highest index, e.g. DI_MODUL_NUM = 15 means 16 modules). DO channels use DI_CH_NUM, as in DT_MATRIX_DO."/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- filters -->
                    <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="KindFilter" Width="250" SelectedIndex="0" SelectionChanged="Filter_Changed">
                                    <ComboBoxItem Content="All signals"/>
                                    <ComboBoxItem Content="Simulator outputs (DI, AI, RTD, COUNTER)"/>
                                    <ComboBoxItem Content="Simulator inputs (DO, AO)"/>
                                    <ComboBoxItem Content="DI"/>
                                    <ComboBoxItem Content="AI"/>
                                    <ComboBoxItem Content="RTD"/>
                                    <ComboBoxItem Content="COUNTER"/>
                                    <ComboBoxItem Content="DO"/>
                                    <ComboBoxItem Content="AO"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="SearchBox" Width="240" VerticalContentAlignment="Center" TextChanged="Filter_Changed"/>
                                <CheckBox x:Name="ShowDisabledCheck" Content="Show disabled channels" VerticalAlignment="Center" Margin="16,0,0,0"
                                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                <CheckBox x:Name="RawEntryCheck" Content="Enter raw values" VerticalAlignment="Center" Margin="16,0,0,0"
                                          ToolTip="SET writes the typed number directly (e.g. 0…27648) instead of converting an engineering value."/>
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" Grid.Column="3" VerticalAlignment="Center" Foreground="#57606A"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="SignalsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TYPE" Width="50" MinWidth="50" Binding="{Binding KindText}"/>
                            <DataGridTextColumn Header="DIR" Width="58" MinWidth="58" Binding="{Binding DirectionText}"/>
                            <DataGridTextColumn Header="MOD" Width="44" MinWidth="44" Binding="{Binding Module}"/>
                            <DataGridTextColumn Header="CH" Width="40" MinWidth="40" Binding="{Binding Channel}"/>
                            <DataGridTextColumn Header="ID" Width="50" MinWidth="50" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="SYSTEM" Width="150" MinWidth="100" Binding="{Binding System}"/>
                            <DataGridTextColumn Header="NAME" Width="*" MinWidth="180" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="PLC NAME" Width="160" MinWidth="100" Binding="{Binding PlcName}"/>
                            <DataGridTextColumn Header="CONFIG" Width="64" MinWidth="64" Binding="{Binding ConfigText}"/>
                            <DataGridTextColumn Header="ADDRESS" Width="80" MinWidth="80" Binding="{Binding Address}"/>
                            <DataGridTemplateColumn Header="VALUE" Width="120" MinWidth="100" SortMemberPath="ValueText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ValueBorder" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" ToolTip="{Binding ScalingDetails}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsTrue}" Value="True">
                                                <Setter TargetName="ValueBorder" Property="Background" Value="#B7E4C7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsErrorValue}" Value="True">
                                                <Setter TargetName="ValueBorder" Property="Background" Value="#FECACA"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="RAW" Width="64" MinWidth="60" Binding="{Binding RawText}"/>
                            <DataGridTemplateColumn Header="SCALING" Width="200" MinWidth="120" SortMemberPath="ScalingText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ScalingText}" ToolTip="{Binding ScalingDetails}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SET" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanSetBool, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="SET TRUE" Style="{StaticResource SetButton}" Click="SetTrue_Click"/>
                                                <Button Content="SET FALSE" Style="{StaticResource SetButton}" Click="SetFalse_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanSetAnalog, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Width="90" Height="24" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                                         Text="{Binding SetText, UpdateSourceTrigger=PropertyChanged}" KeyDown="AnalogBox_KeyDown"
                                                         ToolTip="{Binding ScalingText}"/>
                                                <Button Content="SET" Style="{StaticResource SetButton}" MinWidth="50" Click="SetAnalog_Click"/>
                                                <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Foreground="#57606A"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Program  ">
                <sim:ProgramView x:Name="ProgramPanel"/>
            </TabItem>
            <TabItem Header="  SCADA  ">
                <sim:ScadaView x:Name="ScadaPanel"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
