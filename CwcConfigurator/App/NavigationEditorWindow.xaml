<Window x:Class="CwcConfigurator.App.NavigationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure navigation" Height="720" Width="1120"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" x:Name="RefreshScreensButton" Content="Refresh screens from TIA" Click="RefreshScreens_Click" MinWidth="180"/>
            <TextBlock x:Name="ScreensInfo" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#57606A"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="90" Click="Ok_Click" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Main navigation buttons" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Top" Text="Empty identity = button hidden." Foreground="#57606A" Margin="0,0,0,6"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="Up" Click="ButtonUp_Click" MinWidth="44" Margin="0,0,4,4"/>
                    <Button Content="Down" Click="ButtonDown_Click" MinWidth="44" Margin="0,0,4,4"/>
                    <Button Content="Copy" ToolTip="Copy this whole button (config + cards)" Click="ButtonCopy_Click" MinWidth="44" Margin="0,0,4,4"/>
                    <Button Content="Paste" ToolTip="Overwrite this button with the copied one" Click="ButtonPaste_Click" MinWidth="44" Margin="0,0,4,4"/>
                    <Button Content="Clear" ToolTip="Clear this button (hide it)" Click="ButtonClear_Click" MinWidth="44" Margin="0,0,0,4"/>
                </WrapPanel>
                <ListBox x:Name="ButtonsList" DisplayMemberPath="Display" SelectionChanged="ButtonsList_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="1" x:Name="DetailPanel" DataContext="{Binding SelectedItem, ElementName=ButtonsList}">
                <Border DockPanel.Dock="Top" BorderBrush="#D0D7DE" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Identity / prefix:" VerticalAlignment="Center" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" LostFocus="DetailField_LostFocus" Text="{Binding Identity, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Layout:" VerticalAlignment="Center" Margin="12,3,6,3"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,3" SelectedIndex="{Binding LayoutShape}">
                            <ComboBoxItem Content="With top nav"/>
                            <ComboBoxItem Content="Without top nav"/>
                            <ComboBoxItem Content="Without side content"/>
                            <ComboBoxItem Content="Content only"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Label (EN):" VerticalAlignment="Center" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" LostFocus="DetailField_LostFocus" Text="{Binding LabelEn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Label (2nd):" VerticalAlignment="Center" Margin="12,3,6,3"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,3" Text="{Binding LabelOther, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Icon (id):" VerticalAlignment="Center" Margin="0,3,6,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding IconId, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="First top nav:" VerticalAlignment="Center" Margin="12,3,6,3"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,3" Text="{Binding FirstTopNav, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Side content screen:" VerticalAlignment="Center" Margin="0,3,6,3"/>
                        <ComboBox x:Name="SideContentCombo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3" IsEditable="True" StaysOpenOnEdit="True"
                                  Text="{Binding SideContentScreen, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="Top nav cards (screen opened + label + icon):" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Button Content="Add" Click="CardAdd_Click" MinWidth="56" Margin="0,0,0,4"/>
                    <Button Content="Copy" ToolTip="Copy selected card" Click="CardCopy_Click" MinWidth="56" Margin="0,0,0,4"/>
                    <Button Content="Paste" ToolTip="Paste copied card (also from another button)" Click="CardPaste_Click" MinWidth="56" Margin="0,0,0,10"/>
                    <Button Content="Remove" Click="CardRemove_Click" MinWidth="56" Margin="0,0,0,4"/>
                    <Button Content="Up" Click="CardUp_Click" MinWidth="56" Margin="0,0,0,4"/>
                    <Button Content="Down" Click="CardDown_Click" MinWidth="56"/>
                </StackPanel>
                <DataGrid x:Name="CardsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="All"
                          RowHeaderWidth="34" LoadingRow="CardsGrid_LoadingRow" ItemsSource="{Binding Cards}">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn x:Name="CardScreenColumn" Header="Screen" Width="2*"
                                                SelectedItemBinding="{Binding Screen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Label EN" Width="*" Binding="{Binding LabelEn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Label 2nd" Width="*" Binding="{Binding LabelOther, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Icon (id)" Width="90" Binding="{Binding IconId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
