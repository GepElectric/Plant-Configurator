<Window x:Class="CwcConfigurator.App.PushTargetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Push descriptions — choose SCADAs" Height="440" Width="660"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Each mapped SCADA was scanned for the managed description lists. Only the lists found on a SCADA will be updated (surgical merge) — every other list is left untouched. Choose where to push:"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Push to selected" Width="140" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="TargetsList" BorderThickness="1" BorderBrush="#D0D7DE">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary}" Foreground="#57606A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
