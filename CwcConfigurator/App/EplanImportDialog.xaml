<Window x:Class="CwcConfigurator.App.EplanImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import hardware from EPLAN"
        Width="1320"
        Height="800"
        MinWidth="1000"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="StationList" TargetType="ListBox">
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="DisplayMemberPath" Value="Display"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="StationList_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="StationList_PreviewMouseMove"/>
            <EventSetter Event="DragOver" Handler="StationList_DragOver"/>
            <EventSetter Event="Drop" Handler="StationList_Drop"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- source file -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="EPLAN project (.epj)" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="PathText" Grid.Column="1" Height="26" VerticalContentAlignment="Center" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="Browse..." Width="90" Margin="6,0,0,0" Click="Browse_Click"/>
            <Button x:Name="ReadButton" Grid.Column="3" Content="Read" Width="90" Margin="6,0,0,0" Click="Read_Click"/>
        </Grid>

        <!-- buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="AutoMapButton" DockPanel.Dock="Left" Content="Automap" Width="100" IsEnabled="False" Click="AutoMap_Click"
                    ToolTip="Fills only what is still empty: a database gets the CPU whose unit number is in its name, a free distributed station goes to the CPU with the same unit number (=0BFA01 → =0CJA01). Existing assignments are kept."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save assignments" Padding="10,0" IsEnabled="False" Click="Save_Click"
                        ToolTip="Remember database ↔ CPU and CPU ↔ distributed stations in the project without importing."/>
                <Button x:Name="ImportButton" Content="Import into database" Padding="10,0" Margin="6,0,0,0" IsEnabled="False" Click="Import_Click"
                        ToolTip="Save the assignments and fill the selected database from its CPU and distributed stations."/>
                <Button Content="Close" Width="90" Margin="6,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center" Foreground="#57606A" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1) database ↔ CPU -->
            <DockPanel Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="1  PLC database ↔ CPU"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Select the database to import. Each database gets one CPU from EPLAN."/>
                <ListBox x:Name="DatabaseList" HorizontalContentAlignment="Stretch" SelectionChanged="DatabaseList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Display" SelectedValuePath="Function"
                                          SelectedValue="{Binding CpuFunction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="DatabaseCpu_SelectionChanged"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 2) CPU ↔ distributed stations -->
            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="2  CPU ↔ distributed stations"/>
                <ComboBox x:Name="CpuCombo" DockPanel.Dock="Top" DisplayMemberPath="Header" Margin="0,0,0,4" SelectionChanged="CpuCombo_SelectionChanged"/>
                <TextBlock x:Name="CpuSummary" DockPanel.Dock="Top" Style="{StaticResource Hint}"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Stations of this CPU (order = module numbering)" Foreground="#57606A"/>
                    <ListBox x:Name="AssignedList" Grid.Row="1" Style="{StaticResource StationList}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8">
                        <Button Content="▲" Width="28" ToolTip="Move up" Click="MoveUp_Click"/>
                        <Button Content="▼" Width="28" Margin="4,0,0,0" ToolTip="Move down" Click="MoveDown_Click"/>
                        <Button Content="Remove" Padding="8,0" Margin="4,0,0,0" ToolTip="Back to not assigned" Click="Remove_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Not assigned to any CPU – drag onto the list above" Foreground="#57606A"/>
                    <ListBox x:Name="UnassignedList" Grid.Row="4" Style="{StaticResource StationList}" MouseDoubleClick="UnassignedList_MouseDoubleClick"/>
                </Grid>
            </DockPanel>

            <!-- 3) preview -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="3  Preview"/>
                <ListBox x:Name="WarningList" DockPanel.Dock="Bottom" MaxHeight="110" Margin="0,6,0,0" Foreground="#9A6700" BorderBrush="#D4A72C"/>
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TAB" Binding="{Binding Tab}" Width="62"/>
                        <DataGridTextColumn Header="MODULE NUM" Binding="{Binding ModuleNumber}" Width="80"/>
                        <DataGridTextColumn Header="MODULE NAME" Binding="{Binding ModuleName}" Width="110"/>
                        <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="45"/>
                        <DataGridTextColumn Header="STATION" Binding="{Binding Station}" Width="70"/>
                        <DataGridTextColumn Header="EPLAN SIGNAL" Binding="{Binding Signal}" Width="*"/>
                        <DataGridTextColumn Header="CONNECTED TO" Binding="{Binding ConnectedTo}" Width="95"/>
                        <DataGridTextColumn Header="PDF PAGE" Binding="{Binding PdfPage}" Width="65"/>
                        <DataGridTextColumn Header="SCHEMATIC PAGE" Binding="{Binding SchematicPage}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
