<Window x:Class="CwcConfigurator.App.DbStringRowConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure row"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Discard" Width="92" IsCancel="True"/>
            <Button Content="Apply" Width="92" Click="Apply_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="FieldsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Border x:Name="TemplatePanel" BorderBrush="#D0D7DE" BorderThickness="1" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Description template" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DockPanel>
                            <ComboBox x:Name="TemplateCombo" MinWidth="220" DisplayMemberPath="Key"/>
                            <Button Content="Apply template" Width="112" Margin="8,0,0,0" Click="ApplyTemplate_Click"/>
                            <Button Content="Add current" Width="96" Margin="8,0,0,0" Click="AddCurrentTemplate_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <CheckBox x:Name="ApplyToStructureCheck" Content="Apply names to whole structure" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
