<Window x:Class="CwcConfigurator.App.RecentProjectsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open project"
        Width="720"
        Height="420"
        WindowStartupLocation="CenterOwner"
        MinWidth="560"
        MinHeight="320">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Browse..." Width="92" Click="Browse_Click"/>
            <Button Content="Open" Width="82" Margin="8,0,0,0" Click="Open_Click"/>
            <Button Content="Remove" Width="82" Margin="8,0,0,0" Click="Remove_Click"/>
            <Button Content="Cancel" Width="82" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Recent Plant Configurator projects" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox x:Name="RecentList" Grid.Row="1" MouseDoubleClick="RecentList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" Foreground="#57606A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
