<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PlantConfigurator</AssemblyName>
    <RootNamespace>CwcConfigurator</RootNamespace>
    <ApplicationIcon>PlantConfigurator.ico</ApplicationIcon>
    <!-- Release.ps1 overrides this with -p:Version=x.y.z; Velopack needs Program.Main to run first. -->
    <Version>1.0.0</Version>
    <StartupObject>CwcConfigurator.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="PlantConfigurator.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="S7netplus" Version="0.20.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Templates\Configuration_Unit_List_Template.xlsm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scripts\alm_par_doc.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Templates\description_templates.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Templates\SEQ_PAR.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Templates\alm_par_template.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Templates\alm_par_template_nb.docx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Start Plant Configurator.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Installers\install_prerequisites.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Installers\*.exe" CopyToOutputDirectory="PreserveNewest" />
    <!-- GitHub token for Help -> Report a bug; local only (.gitignore), shipped inside the release package. -->
    <None Include="bugreport.token" CopyToOutputDirectory="PreserveNewest" Condition="Exists('bugreport.token')" />
    <None Include="..\..\tag_browser\dist\WinCC_Tag_Browser.exe" Link="Tools\tag_browser\WinCC_Tag_Browser.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tag_browser\dist\WinCC_Tag_Browser.exe')" />
    <None Include="..\..\tag_browser\tags_config.json" Link="Tools\tag_browser\tags_config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tag_browser\tags_config.json')" />
    <None Include="Tools\WinCCUnifiedJsConnector\server\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Tools\python\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Build both version-specific helper exes and stage them under TiaHelper/V18 and
       TiaHelper/V21. The app launches the one matching the attached TIA process version. -->
  <Target Name="CopyTiaHelper" AfterTargets="Build;Publish">
    <MSBuild Projects="..\CwcConfigurator.TiaHelper\CwcConfigurator.TiaHelper.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="..\CwcConfigurator.TiaHelper.V21\CwcConfigurator.TiaHelper.V21.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <TiaHelperV18Files Include="..\CwcConfigurator.TiaHelper\bin\$(Configuration)\net48\**\*.*" />
      <TiaHelperV21Files Include="..\CwcConfigurator.TiaHelper.V21\bin\$(Configuration)\net48\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TiaHelperV18Files)" DestinationFiles="@(TiaHelperV18Files->'$(OutputPath)TiaHelper\V18\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TiaHelperV21Files)" DestinationFiles="@(TiaHelperV21Files->'$(OutputPath)TiaHelper\V21\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TiaHelperV18Files)" DestinationFiles="@(TiaHelperV18Files->'$(PublishDir)TiaHelper\V18\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(TiaHelperV21Files)" DestinationFiles="@(TiaHelperV21Files->'$(PublishDir)TiaHelper\V21\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
