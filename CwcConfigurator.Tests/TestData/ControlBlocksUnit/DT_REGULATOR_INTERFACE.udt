TYPE "DT_REGULATOR_INTERFACE"
VERSION : 0.1
   STRUCT
      ID : Int;
      CONFIGURED : Bool;   // REGULATOR CONFIGURED
      REFERENCE_MAN_MODE : Bool;   // 0 - REFERENCE FROM SYSTEM, 1 - REFERENCE FROM REGULATOR
      OUTPUT_MAN_MODE : Bool;   // 0 - OUTPUT FROM PID, 1 - OUTPUT FROM SPARE VARIABLE
      MAN_MODE : Bool;   // 0 - AUTO MODE, 1 - MANUAL MODE
      ACTIVE : Bool;   // REGULATOR ACTIVE
      VALVE_CTRL : Int;   // 0 - DIGITAL CONTROL, 1 - ANALOG CONTROL
      OB_3X_CYCLE : Time;   // OB 3X CYCLE
      REG_CYCLE : Time;   // REGULATOR CYCLE
      VALUES { S7_SetPoint := 'False'} : "DT_REGULATOR_VALUES_INTERFACE";
   END_STRUCT;

END_TYPE

